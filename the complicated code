<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
  <title>Eugene’s Deal Finder</title>
  <style>
    :root {
      --green: #2e7d32;
      --green-light: #e8f5e9;
      --red: #c62828;
      --woolies: #178841;
      --coles: #e01a22;
      --bg: #f7f9f7;
      --card: #ffffff;
      --text: #222;
      --muted: #666;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background: var(--bg);
      color: var(--text);
      line-height: 1.4;
      padding-bottom: 40px;
    }

    header {
      background: white;
      padding: 18px 16px 12px;
      text-align: center;
      box-shadow: 0 2px 8px rgba(0,0,0,0.06);
      position: sticky;
      top: 0;
      z-index: 10;
    }

    header h1 {
      font-size: 1.5rem;
      color: var(--green);
      margin-bottom: 2px;
    }

    header p {
      font-size: 0.85rem;
      color: var(--muted);
    }

    .tabs {
      display: flex;
      background: white;
      border-bottom: 1px solid #eee;
      position: sticky;
      top: 70px;
      z-index: 9;
    }

    .tab {
      flex: 1;
      text-align: center;
      padding: 14px 8px;
      font-weight: 600;
      font-size: 0.95rem;
      color: var(--muted);
      cursor: pointer;
      border-bottom: 3px solid transparent;
    }

    .tab.active {
      color: var(--green);
      border-bottom-color: var(--green);
    }

    .content {
      padding: 16px;
      max-width: 600px;
      margin: 0 auto;
    }

    .search-box {
      display: none;
      margin-bottom: 16px;
    }

    .search-box input {
      width: 100%;
      padding: 14px 16px;
      font-size: 1.1rem;
      border: 2px solid #ddd;
      border-radius: 12px;
      outline: none;
    }

    .search-box input:focus {
      border-color: var(--green);
    }

    .card {
      background: var(--card);
      border-radius: 14px;
      padding: 16px;
      margin-bottom: 14px;
      box-shadow: 0 2px 6px rgba(0,0,0,0.05);
      border: 1px solid #eee;
    }

    .card.on-special {
      background: var(--green-light);
      border-color: #a5d6a7;
    }

    .store {
      display: inline-block;
      font-size: 0.75rem;
      font-weight: 700;
      padding: 3px 8px;
      border-radius: 6px;
      color: white;
      margin-bottom: 6px;
    }

    .store.woolworths { background: var(--woolies); }
    .store.coles { background: var(--coles); }

    .name {
      font-size: 1.15rem;
      font-weight: 600;
      margin-bottom: 8px;
    }

    .price-row {
      display: flex;
      align-items: baseline;
      gap: 10px;
      flex-wrap: wrap;
    }

    .price {
      font-size: 1.6rem;
      font-weight: 700;
      color: var(--green);
    }

    .was {
      font-size: 1rem;
      color: var(--muted);
      text-decoration: line-through;
    }

    .save {
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--green);
      background: #c8e6c9;
      padding: 2px 8px;
      border-radius: 6px;
    }

    .badge {
      display: inline-block;
      background: var(--green);
      color: white;
      font-size: 0.8rem;
      font-weight: 700;
      padding: 3px 8px;
      border-radius: 6px;
      margin-left: 6px;
    }

    .cup {
      font-size: 0.9rem;
      color: var(--muted);
      margin-top: 4px;
    }

    .empty {
      text-align: center;
      padding: 40px 20px;
      color: var(--muted);
    }

    footer {
      text-align: center;
      padding: 30px 16px;
      font-size: 0.85rem;
      color: var(--muted);
    }

    footer strong {
      color: var(--green);
    }

    .updated {
      font-size: 0.8rem;
      color: var(--muted);
      text-align: center;
      margin-bottom: 12px;
    }
  </style>
</head>
<body>

<header>
  <h1>Eugene’s Deal Finder</h1>
  <p>Made with love by Eugene • for Mum</p>
</header>

<div class="tabs">
  <div class="tab active" data-tab="specials">On Special Today</div>
  <div class="tab" data-tab="all">All My Items</div>
  <div class="tab" data-tab="search">Search</div>
</div>

<div class="content">
  <div class="updated" id="updated">Loading prices...</div>

  <div class="search-box" id="searchBox">
    <input type="text" id="searchInput" placeholder="Search any item (e.g. yoghurt, rice...)">
  </div>

  <div id="list"></div>
</div>

<footer>
  Made with ♥ by <strong>Eugene Wong</strong><br>
  for Mum’s birthday
</footer>

<script>
  let allData = [];

  // Load the prices.json file (created by the daily script)
  async function loadPrices() {
    try {
      const res = await fetch('prices.json?t=' + Date.now());
      const data = await res.json();
      allData = data.items || [];
      document.getElementById('updated').textContent = 
        'Updated: ' + (data.updated || 'unknown');
      showTab('specials');
    } catch (e) {
      document.getElementById('list').innerHTML = 
        '<div class="empty">Prices not ready yet.<br>Please wait for the first daily update.</div>';
    }
  }

  function showTab(tab) {
    // Update active tab
    document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
    document.querySelector(`[data-tab="${tab}"]`).classList.add('active');

    // Show/hide search box
    document.getElementById('searchBox').style.display = tab === 'search' ? 'block' : 'none';

    if (tab === 'specials') {
      render(allData.filter(i => i.is_on_special));
    } else if (tab === 'all') {
      render(allData);
    } else {
      // Search tab – start empty
      render([]);
      document.getElementById('searchInput').value = '';
      document.getElementById('searchInput').focus();
    }
  }

  function render(items) {
    const list = document.getElementById('list');
    
    if (items.length === 0) {
      list.innerHTML = '<div class="empty">No items to show right now</div>';
      return;
    }

    list.innerHTML = items.map(item => {
      const specialClass = item.is_on_special ? 'on-special' : '';
      const storeClass = item.store.toLowerCase().includes('wool') ? 'woolworths' : 'coles';
      
      let saveHtml = '';
      if (item.is_on_special && item.was_price && item.was_price > item.price) {
        const save = (item.was_price - item.price).toFixed(2);
        saveHtml = `<span class="save">Save $${save}</span>`;
      }

      return `
        <div class="card ${specialClass}">
          <span class="store ${storeClass}">${item.store}</span>
          ${item.is_on_special ? '<span class="badge">ON SPECIAL</span>' : ''}
          <div class="name">${item.name}</div>
          <div class="price-row">
            <span class="price">$${Number(item.price).toFixed(2)}</span>
            ${item.was_price && item.was_price > item.price ? 
              `<span class="was">$${Number(item.was_price).toFixed(2)}</span>` : ''}
            ${saveHtml}
          </div>
          ${item.cup_string ? `<div class="cup">${item.cup_string}</div>` : ''}
        </div>
      `;
    }).join('');
  }

  // Tab clicks
  document.querySelectorAll('.tab').forEach(tab => {
    tab.addEventListener('click', () => showTab(tab.dataset.tab));
  });

  // Simple search (searches the already loaded list for now)
  document.getElementById('searchInput').addEventListener('input', (e) => {
    const q = e.target.value.toLowerCase().trim();
    if (!q) {
      render([]);
      return;
    }
    const filtered = allData.filter(i => 
      i.name.toLowerCase().includes(q) || 
      (i.search_term && i.search_term.toLowerCase().includes(q))
    );
    render(filtered);
  });

  // Start
  loadPrices();
</script>
</body>
</html>
